# Local dashboard. Restart after changes.
# Evaluation selection and bulk deletion use workspace permissions; no additional configuration is needed.
# Contribution requests use existing GitHub roles and in-app badges; no email configuration is needed.
# Admin-only review runs use the separate server generator/grader credentials below.
PORT=3000
HOST=127.0.0.1

# GitHub OAuth App. Create separate registrations for local and production origins.
# Callback: APP_ORIGIN + /api/auth/github/callback (local: http://127.0.0.1:3000/api/auth/github/callback).
# Missing OAuth credentials disables login; anonymous access is not enabled.
OAUTH_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated immutable numeric GitHub account IDs. Everyone else is a collaborator.
ADMIN_GITHUB_IDS=
# Sessions identify accounts; personal workspaces survive cookie expiry and device changes.
# My workspace Actions loads the current shared TestCraft library without provider calls or an API key.
# Stable workshop identity: sessions and saved data use this scope.
# Changing this starts a different workshop.
WORKSHOP_ID=workshop
WORKSHOP_SESSION_HOURS=24
# Manage model spending through API keys and provider-side budgets.
# For AWS: the exact public HTTPS origin, e.g. https://evals.example.com
# Required with NODE_ENV=production or HOST=0.0.0.0. Enables Secure cookies.
APP_ORIGIN=

# Legacy internal adapter default only. New runs use the fixed Prod/Dev/Local destinations
# selected in Create Run; this value does not override those destinations.
TESTCRAFT_BASE_URL=https://api.testcraft.app
# OPTIONAL: explicitly forwarded to TestCraft as openAiApiKey.
# Leave blank to use the API's own credentials, if configured there.
TESTCRAFT_OPENAI_API_KEY=

# Admin run-level model grading and the legacy internal backend LLM adapter.
# Collaborators enter their own key in the UI; it is sent explicitly to TestCraft and OpenAI, never saved.
# Saving checks GET OPENAI_BASE_URL/models without generating output; the key needs model-list read access.
# Create Run requires a validated tab key for collaborators. Refresh/sign-out clears it.
# Test count also requires this key and shares one judge call with quality criteria.
# This key is sent ONLY to OPENAI_BASE_URL, never implicitly to TestCraft.
OPENAI_API_KEY=
# AWS only: JSON secret with GITHUB_CLIENT_SECRET, OPENAI_API_KEY and optional TESTCRAFT_OPENAI_API_KEY.
# Retrieved at startup with the EC2 instance role. Leave blank for local .env mode.
AWS_SECRET_ARN=
AWS_REGION=us-east-1
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Legacy grader default and modal fallback when Luna is absent from the catalog.
# New-run selectors prefer GPT-6 Luna, then the existing GPT-5.6 Luna entry.
# Create Run has a multi-select generation-model dropdown; one grader applies to every model.
# Each evaluation/model pair makes its own generation and applicable grading calls.
JUDGE_MODEL=gpt-4o-mini

# Optional SQLite path. Default: data/evals.sqlite inside this project.
# TESTCRAFT_EVALS_DB=C:/path/to/evals.sqlite
